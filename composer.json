{
    "name": "xpiston/openfga",
    "description": "A PHP SDK for OpenFGA: checks, relationship tuples, authorization models and a real DSL parser, for Laravel, Symfony or no framework at all.",
    "keywords": [
        "openfga",
        "fga",
        "zanzibar",
        "authorization",
        "rebac",
        "fine-grained-authorization",
        "laravel",
        "symfony",
        "psr-18"
    ],
    "homepage": "https://github.com/xPiston/openfga",
    "license": "MIT",
    "authors": [
        {
            "name": "xPiston",
            "homepage": "https://github.com/xPiston"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "php-http/discovery": "^1.19",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "php-http/discovery": "Finds the PSR-18 client and PSR-17 factories on its own, so nothing has to be wired.",
        "symfony/http-client": "A PSR-18 client.",
        "guzzlehttp/guzzle": "A PSR-18 client."
    },
    "autoload": {
        "psr-4": {
            "Piston\\OpenFga\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Piston\\OpenFga\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Piston\\OpenFga\\Bridge\\Laravel\\OpenFgaServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:live": "phpunit -c phpunit.live.xml",
        "quality": [
            "@test:lint",
            "@analyse",
            "@test"
        ]
    }
}
